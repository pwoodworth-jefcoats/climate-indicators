! The purpose of this script is to look at estimated median phytoplankton size for the SAFE report

! Load data
use https://oceanwatch.pifsc.noaa.gov/erddap/griddap/md50_exp

! Years of interest
! 1 = Jan 1998
! 288 = Dec 2021
! 289 = Jan 2022
! 300 = Dec 2022
! 301 = Jan 2023
! 312 = Dec 2023
! 313 = Jan 2024
! 324 = Dec 2024

! Area of interest
! 15 - 45N, 180 - 120W
! x=180:120W, y=15:45N

! Full time series, spatially averaged
! This product is derived from a product that is reprocessed annually, so it makes sense to redo this each year.
! Okay, memory is an issue here, so we're going to do this in stages
let medphyto_ts_9802 = MD50[x = 180:120W@ave, y = 15:45N@ave, l=1:60]
let medphyto_ts_0307 = MD50[x = 180:120W@ave, y = 15:45N@ave, l=61:120]
let medphyto_ts_0812 = MD50[x = 180:120W@ave, y = 15:45N@ave, l=121:180]
let medphyto_ts_1317 = MD50[x = 180:120W@ave, y = 15:45N@ave, l=181:240]
let medphyto_ts_1822 = MD50[x = 180:120W@ave, y = 15:45N@ave, l=241:300]
let medphyto_ts_2324 = MD50[x = 180:120W@ave, y = 15:45N@ave, l=301:324]

list/CLOBBER/FILE=medphyto_ts_9802.dat/FORMAT=comma medphyto_ts_9802
list/CLOBBER/FILE=medphyto_ts_0307.dat/FORMAT=comma medphyto_ts_0307
list/CLOBBER/FILE=medphyto_ts_0812.dat/FORMAT=comma medphyto_ts_0812
list/CLOBBER/FILE=medphyto_ts_1317.dat/FORMAT=comma medphyto_ts_1317
list/CLOBBER/FILE=medphyto_ts_1822.dat/FORMAT=comma medphyto_ts_1822
list/CLOBBER/FILE=medphyto_ts_2324.dat/FORMAT=comma medphyto_ts_2324

cancel data/all
cancel var/all

! Climo, 1998 - 2009, regridded to 0.25 degree resolution to try to decrease file size
! and to harmonize across remotely sensed variables
! This is derived from a product that is reprocessed annually, so it makes sense to redo this each year.
! Define new axis
DEFINE AXIS/X=120E:100W:0.25/UNITS=degrees x025deg
DEFINE AXIS/Y=0:55N:0.25/UNITS=degrees y025deg
use https://oceanwatch.pifsc.noaa.gov/erddap/griddap/md50_exp-1998-2009-clim
let medphyto_regrid = MD50[GX=x025deg, GY=y025deg]
! shade/palette=cmocean_algae MD50[x=120E:100W, y=0:55N, l=1]
let medphyto_climo = medphyto_regrid[x=120E:100W, y=0:55N, l=1]
list/CLOBBER/FILE=medphyto_climo.nc/FORMAT=cdf medphyto_climo

cancel data/all
cancel var/all

! Current year for anomaly calculation, 2024, for anomaly calculation regridded to 0.25 degree resolution to try to decrease file size
! and to harmonize across remotely sensed variables
use https://oceanwatch.pifsc.noaa.gov/erddap/griddap/md50_exp-2024-clim
let medphyto_regrid = MD50[GX=x025deg, GY=y025deg]
! shade/palette=cmocean_algae MD50[x=120E:100W, y=0:55N, l=1]
let medphyto_2024 = medphyto_regrid[x=120E:100W, y=0:55N, l=1]
list/FILE=medphyto_yr2024.nc/FORMAT=cdf medphyto_2024

! Dashboard maps files
! Coarser resolution (0.5) needed to keep the file size reasonable
! This coarsening used to be done in the code that aggregates the map data
! But we'll regrid instead
DEFINE AXIS/X=120E:100W:0.5/UNITS=degrees x05deg
DEFINE AXIS/Y=0:55N:0.5/UNITS=degrees y05deg
use https://oceanwatch.pifsc.noaa.gov/erddap/griddap/md50_exp-1998-2009-clim
let medphyto_regrid = MD50[GX=x05deg, GY=y05deg]
! shade/palette=cmocean_algae MD50[x=120E:100W, y=0:55N, l=1]
let medphyto_climo = medphyto_regrid[x=120E:100W, y=0:55N, l=1]
list/CLOBBER/FILE=medphyto_climo_dashboard.nc/FORMAT=cdf medphyto_climo

cancel data/all
cancel var/all

! Current year for anomaly calculation, 2024, for anomaly calculation regridded to 0.25 degree resolution to try to decrease file size
! and to harmonize across remotely sensed variables
use https://oceanwatch.pifsc.noaa.gov/erddap/griddap/md50_exp-2024-clim
let medphyto_regrid = MD50[GX=x05deg, GY=y05deg]
! shade/palette=cmocean_algae MD50[x=120E:100W, y=0:55N, l=1]
let medphyto_2024 = medphyto_regrid[x=120E:100W, y=0:55N, l=1]
list/FILE=medphyto_yr2024_dashboard.nc/FORMAT=cdf medphyto_2024
