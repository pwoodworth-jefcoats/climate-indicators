! go mp_orthographic 195 30
! set GRID TATD_climo[d=1]
! go mp_aspect
! shade/palette=ocean_blue TATD_climo[d=1]
! contour/over/levels=0.5DC TATD_2020[d=2]-TATD_climo[d=1]
